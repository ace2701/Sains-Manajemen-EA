#property strict
#property version   "1.00"
#property description "EA-20 - ATR Volatility Breakout"

#include <Trade/Trade.mqh>

CTrade trade;

//---------------------------------------------------------
// Inputs
//---------------------------------------------------------
input ulong  MagicNumber                    = 20020;
input double FixedLotSize                   = 0.10;
input int    MaximumAllowedSpreadPoints     = 50;

// Breakout
input int    BreakoutLookbackPeriod         = 20;
input int    BreakoutBufferPoints           = 10;

// ATR
input int    ATRPeriod                      = 14;
input double ATRExpansionMultiplier         = 1.05;
input double ATRStopMultiplier              = 1.5;
input int    MinimumStopLossPoints          = 100;
input int    MaximumStopLossPoints          = 600;

// EMA
input bool   EnableEMAFilter                = true;
input int    EMAPeriod                      = 50;

// Take Profit
input double RiskRewardRatio                = 1.5;

// Exit
input bool   EnableOppositeBreakoutExit     = false;
input bool   EnableTrailingStop             = false;
input double TrailingATRMultiplier          = 1.5;

// Trading Hours
input bool   EnableTradingHours             = false;
input int    TradingStartHour               = 0;
input int    TradingEndHour                 = 23;

//---------------------------------------------------------
// Global variables
//---------------------------------------------------------
int      atrHandle = INVALID_HANDLE;
int      emaHandle = INVALID_HANDLE;
datetime lastBarTime = 0;

//---------------------------------------------------------
// Function declarations
//---------------------------------------------------------
bool   IsNewBar();
double GetATRValue(const int shift);
double GetEMAValue(const int shift);
bool   GetBreakoutLevels(double &previousHigh, double &previousLow);
bool   HasOpenPosition();
bool   IsSpreadAcceptable();
bool   IsTradingHour();
double NormalizeVolume(const double requestedVolume);
double CalculateStopDistance(const double atrValue);
double NormalizePrice(const double price);
bool   IsTradeSuccess();
bool   OpenBuy(const double atrValue);
bool   OpenSell(const double atrValue);
void   ManageTrailingStop();
void   ManageOppositeExit();

//---------------------------------------------------------
// Expert initialization
//---------------------------------------------------------
int OnInit()
{
   if(BreakoutLookbackPeriod < 2)
      return INIT_PARAMETERS_INCORRECT;

   if(ATRPeriod < 1)
      return INIT_PARAMETERS_INCORRECT;

   if(EMAPeriod < 1)
      return INIT_PARAMETERS_INCORRECT;

   if(FixedLotSize <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(ATRExpansionMultiplier <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(ATRStopMultiplier <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(RiskRewardRatio <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(MinimumStopLossPoints < 0 || MaximumStopLossPoints < MinimumStopLossPoints)
      return INIT_PARAMETERS_INCORRECT;

   if(MaximumAllowedSpreadPoints < 0)
      return INIT_PARAMETERS_INCORRECT;

   if(TradingStartHour < 0 || TradingStartHour > 23)
      return INIT_PARAMETERS_INCORRECT;

   if(TradingEndHour < 0 || TradingEndHour > 23)
      return INIT_PARAMETERS_INCORRECT;

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.SetAsyncMode(false);

   atrHandle = iATR(_Symbol, _Period, ATRPeriod);
   if(atrHandle == INVALID_HANDLE)
      return INIT_FAILED;

   if(EnableEMAFilter || EnableTrailingStop)
   {
      emaHandle = iMA(
         _Symbol,
         _Period,
         EMAPeriod,
         0,
         MODE_EMA,
         PRICE_CLOSE
      );

      if(emaHandle == INVALID_HANDLE)
      {
         IndicatorRelease(atrHandle);
         atrHandle = INVALID_HANDLE;
         return INIT_FAILED;
      }
   }

   lastBarTime = iTime(_Symbol, _Period, 0);

   return INIT_SUCCEEDED;
}

//---------------------------------------------------------
// Expert deinitialization
//---------------------------------------------------------
void OnDeinit(const int reason)
{
   if(atrHandle != INVALID_HANDLE)
   {
      IndicatorRelease(atrHandle);
      atrHandle = INVALID_HANDLE;
   }

   if(emaHandle != INVALID_HANDLE)
   {
      IndicatorRelease(emaHandle);
      emaHandle = INVALID_HANDLE;
   }
}

//---------------------------------------------------------
// Expert tick
//---------------------------------------------------------
void OnTick()
{
   if(EnableTrailingStop)
      ManageTrailingStop();

   if(!IsNewBar())
      return;

   if(EnableOppositeBreakoutExit)
      ManageOppositeExit();

   if(HasOpenPosition())
      return;

   if(!IsTradingHour())
      return;

   if(!IsSpreadAcceptable())
      return;

   if(Bars(_Symbol, _Period) < BreakoutLookbackPeriod + ATRPeriod + 10)
      return;

   double atrCurrent = GetATRValue(1);
   double atrPrevious = GetATRValue(2);

   if(atrCurrent <= 0.0 || atrPrevious <= 0.0)
      return;

   if(atrCurrent < atrPrevious * ATRExpansionMultiplier)
      return;

   MqlRates signalRates[1];

   if(CopyRates(_Symbol, _Period, 1, 1, signalRates) != 1)
      return;

   const double signalOpen  = signalRates[0].open;
   const double signalClose = signalRates[0].close;

   double previousHigh = 0.0;
   double previousLow  = 0.0;

   if(!GetBreakoutLevels(previousHigh, previousLow))
      return;

   double emaValue = 0.0;

   if(EnableEMAFilter)
   {
      emaValue = GetEMAValue(1);

      if(emaValue <= 0.0)
         return;
   }

   const double buffer = BreakoutBufferPoints * _Point;

   const bool bullishCandle = signalClose > signalOpen;
   const bool bearishCandle = signalClose < signalOpen;

   const bool buyBreakout =
      signalClose > (previousHigh + buffer);

   const bool sellBreakout =
      signalClose < (previousLow - buffer);

   if(buyBreakout && bullishCandle)
   {
      if(!EnableEMAFilter || signalClose > emaValue)
         OpenBuy(atrCurrent);
   }
   else if(sellBreakout && bearishCandle)
   {
      if(!EnableEMAFilter || signalClose < emaValue)
         OpenSell(atrCurrent);
   }
}

//---------------------------------------------------------
// New bar detection
//---------------------------------------------------------
bool IsNewBar()
{
   const datetime currentBarTime = iTime(_Symbol, _Period, 0);

   if(currentBarTime <= 0)
      return false;

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//---------------------------------------------------------
// Get ATR value
//---------------------------------------------------------
double GetATRValue(const int shift)
{
   if(atrHandle == INVALID_HANDLE)
      return 0.0;

   if(shift < 0)
      return 0.0;

   double buffer[1];

   if(CopyBuffer(atrHandle, 0, shift, 1, buffer) != 1)
      return 0.0;

   if(buffer[0] <= 0.0)
      return 0.0;

   return buffer[0];
}

//---------------------------------------------------------
// Get EMA value
//---------------------------------------------------------
double GetEMAValue(const int shift)
{
   if(emaHandle == INVALID_HANDLE)
      return 0.0;

   if(shift < 0)
      return 0.0;

   double buffer[1];

   if(CopyBuffer(emaHandle, 0, shift, 1, buffer) != 1)
      return 0.0;

   if(buffer[0] <= 0.0)
      return 0.0;

   return buffer[0];
}

//---------------------------------------------------------
// Calculate breakout range
//
// The signal candle is shift 1.
// Range uses shifts 2 through:
// 2 + BreakoutLookbackPeriod - 1
//---------------------------------------------------------
bool GetBreakoutLevels(double &previousHigh, double &previousLow)
{
   previousHigh = 0.0;
   previousLow  = 0.0;

   if(BreakoutLookbackPeriod < 2)
      return false;

   MqlRates rangeRates[];

   ArrayResize(rangeRates, BreakoutLookbackPeriod);

   const int copied = CopyRates(
      _Symbol,
      _Period,
      2,
      BreakoutLookbackPeriod,
      rangeRates
   );

   if(copied != BreakoutLookbackPeriod)
      return false;

   double highest = rangeRates[0].high;
   double lowest  = rangeRates[0].low;

   for(int i = 1; i < copied; i++)
   {
      if(rangeRates[i].high > highest)
         highest = rangeRates[i].high;

      if(rangeRates[i].low < lowest)
         lowest = rangeRates[i].low;
   }

   if(highest <= 0.0 || lowest <= 0.0)
      return false;

   previousHigh = highest;
   previousLow  = lowest;

   return true;
}

//---------------------------------------------------------
// Check whether this EA has an open position on symbol
//---------------------------------------------------------
bool HasOpenPosition()
{
   const int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      const ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      const string symbol = PositionGetString(POSITION_SYMBOL);
      const long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && (ulong)magic == MagicNumber)
         return true;
   }

   return false;
}

//---------------------------------------------------------
// Spread filter
//---------------------------------------------------------
bool IsSpreadAcceptable()
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   if(tick.ask <= 0.0 || tick.bid <= 0.0)
      return false;

   const double spreadPoints = (tick.ask - tick.bid) / _Point;

   return spreadPoints <= (double)MaximumAllowedSpreadPoints;
}

//---------------------------------------------------------
// Trading hours filter
//---------------------------------------------------------
bool IsTradingHour()
{
   if(!EnableTradingHours)
      return true;

   MqlDateTime timeStruct;

   if(!TimeToStruct(TimeCurrent(), timeStruct))
      return false;

   const int hour = timeStruct.hour;

   if(TradingStartHour == TradingEndHour)
      return true;

   if(TradingStartHour < TradingEndHour)
   {
      return hour >= TradingStartHour && hour <= TradingEndHour;
   }

   // Overnight session, e.g. 22 -> 5
   return hour >= TradingStartHour || hour <= TradingEndHour;
}

//---------------------------------------------------------
// Normalize volume according to broker constraints
//---------------------------------------------------------
double NormalizeVolume(const double requestedVolume)
{
   const double minVolume  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   const double maxVolume  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   const double volumeStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(minVolume <= 0.0 || maxVolume <= 0.0 || volumeStep <= 0.0)
      return 0.0;

   double volume = requestedVolume;

   if(volume < minVolume)
      volume = minVolume;

   if(volume > maxVolume)
      volume = maxVolume;

   volume = MathFloor(volume / volumeStep + 1.0e-9) * volumeStep;

   if(volume < minVolume)
      volume = minVolume;

   if(volume > maxVolume)
      volume = maxVolume;

   int volumeDigits = 0;
   double stepCheck = volumeStep;

   while(volumeDigits < 8 && MathAbs(stepCheck - MathRound(stepCheck)) > 1.0e-9)
   {
      stepCheck *= 10.0;
      volumeDigits++;
   }

   return NormalizeDouble(volume, volumeDigits);
}

//---------------------------------------------------------
// Calculate dynamic ATR stop distance
//---------------------------------------------------------
double CalculateStopDistance(const double atrValue)
{
   if(atrValue <= 0.0)
      return 0.0;

   double stopDistance = atrValue * ATRStopMultiplier;

   const double minimumConfigured =
      (double)MinimumStopLossPoints * _Point;

   const double maximumConfigured =
      (double)MaximumStopLossPoints * _Point;

   if(stopDistance < minimumConfigured)
      stopDistance = minimumConfigured;

   if(stopDistance > maximumConfigured)
      stopDistance = maximumConfigured;

   const long stopsLevelPoints =
      SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);

   const double brokerMinimum =
      (double)stopsLevelPoints * _Point;

   if(stopDistance < brokerMinimum)
      stopDistance = brokerMinimum;

   if(stopDistance <= 0.0)
      return 0.0;

   return stopDistance;
}

//---------------------------------------------------------
// Normalize price
//---------------------------------------------------------
double NormalizePrice(const double price)
{
   return NormalizeDouble(price, _Digits);
}

//---------------------------------------------------------
// Check CTrade return code
//---------------------------------------------------------
bool IsTradeSuccess()
{
   const uint retcode = trade.ResultRetcode();

   return retcode == TRADE_RETCODE_DONE ||
          retcode == TRADE_RETCODE_PLACED ||
          retcode == TRADE_RETCODE_DONE_PARTIAL;
}

//---------------------------------------------------------
// Open BUY
//---------------------------------------------------------
bool OpenBuy(const double atrValue)
{
   if(HasOpenPosition())
      return false;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   if(tick.ask <= 0.0)
      return false;

   const double stopDistance = CalculateStopDistance(atrValue);

   if(stopDistance <= 0.0)
      return false;

   const double entryPrice = tick.ask;

   double stopLoss =
      entryPrice - stopDistance;

   double takeProfit =
      entryPrice + stopDistance * RiskRewardRatio;

   stopLoss   = NormalizePrice(stopLoss);
   takeProfit = NormalizePrice(takeProfit);

   const double volume = NormalizeVolume(FixedLotSize);

   if(volume <= 0.0)
      return false;

   ResetLastError();

   const bool sent = trade.Buy(
      volume,
      _Symbol,
      0.0,
      stopLoss,
      takeProfit,
      "EA-20 ATR Volatility Breakout BUY"
   );

   if(!sent)
      return false;

   return IsTradeSuccess();
}

//---------------------------------------------------------
// Open SELL
//---------------------------------------------------------
bool OpenSell(const double atrValue)
{
   if(HasOpenPosition())
      return false;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   if(tick.bid <= 0.0)
      return false;

   const double stopDistance = CalculateStopDistance(atrValue);

   if(stopDistance <= 0.0)
      return false;

   const double entryPrice = tick.bid;

   double stopLoss =
      entryPrice + stopDistance;

   double takeProfit =
      entryPrice - stopDistance * RiskRewardRatio;

   stopLoss   = NormalizePrice(stopLoss);
   takeProfit = NormalizePrice(takeProfit);

   const double volume = NormalizeVolume(FixedLotSize);

   if(volume <= 0.0)
      return false;

   ResetLastError();

   const bool sent = trade.Sell(
      volume,
      _Symbol,
      0.0,
      stopLoss,
      takeProfit,
      "EA-20 ATR Volatility Breakout SELL"
   );

   if(!sent)
      return false;

   return IsTradeSuccess();
}

//---------------------------------------------------------
// Trailing stop management
//---------------------------------------------------------
void ManageTrailingStop()
{
   if(!EnableTrailingStop)
      return;

   if(atrHandle == INVALID_HANDLE)
      return;

   const double atrValue = GetATRValue(1);

   if(atrValue <= 0.0)
      return;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   const double trailingDistance =
      atrValue * TrailingATRMultiplier;

   if(trailingDistance <= 0.0)
      return;

   const long stopsLevelPoints =
      SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);

   const double minimumStopDistance =
      (double)stopsLevelPoints * _Point;

   const double effectiveDistance =
      MathMax(trailingDistance, minimumStopDistance);

   const int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      const ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      const string symbol =
         PositionGetString(POSITION_SYMBOL);

      const long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol || (ulong)magic != MagicNumber)
         continue;

      const ENUM_POSITION_TYPE positionType =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      const double currentSL =
         PositionGetDouble(POSITION_SL);

      const double currentTP =
         PositionGetDouble(POSITION_TP);

      if(positionType == POSITION_TYPE_BUY)
      {
         const double newSL =
            NormalizePrice(tick.bid - effectiveDistance);

         if(newSL <= 0.0)
            continue;

         if(currentSL == 0.0 || newSL > currentSL + _Point)
         {
            trade.PositionModify(
               _Symbol,
               newSL,
               currentTP
            );
         }
      }
      else if(positionType == POSITION_TYPE_SELL)
      {
         const double newSL =
            NormalizePrice(tick.ask + effectiveDistance);

         if(newSL <= 0.0)
            continue;

         if(currentSL == 0.0 || newSL < currentSL - _Point)
         {
            trade.PositionModify(
               _Symbol,
               newSL,
               currentTP
            );
         }
      }
   }
}

//---------------------------------------------------------
// Optional opposite breakout exit
//---------------------------------------------------------
void ManageOppositeExit()
{
   if(!EnableOppositeBreakoutExit)
      return;

   if(!HasOpenPosition())
      return;

   MqlRates signalRates[1];

   if(CopyRates(_Symbol, _Period, 1, 1, signalRates) != 1)
      return;

   double previousHigh = 0.0;
   double previousLow  = 0.0;

   if(!GetBreakoutLevels(previousHigh, previousLow))
      return;

   const double buffer =
      BreakoutBufferPoints * _Point;

   const double signalClose =
      signalRates[0].close;

   const bool oppositeDownBreakout =
      signalClose < (previousLow - buffer);

   const bool oppositeUpBreakout =
      signalClose > (previousHigh + buffer);

   const int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      const ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      const string symbol =
         PositionGetString(POSITION_SYMBOL);

      const long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol || (ulong)magic != MagicNumber)
         continue;

      const ENUM_POSITION_TYPE positionType =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      bool shouldClose = false;

      if(positionType == POSITION_TYPE_BUY && oppositeDownBreakout)
         shouldClose = true;

      if(positionType == POSITION_TYPE_SELL && oppositeUpBreakout)
         shouldClose = true;

      if(shouldClose)
      {
         ResetLastError();

         const bool closed =
            trade.PositionClose(ticket);

         if(!closed)
            continue;

         if(!IsTradeSuccess())
            continue;
      }
   }
}