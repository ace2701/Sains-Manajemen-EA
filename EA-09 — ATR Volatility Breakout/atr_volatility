//+------------------------------------------------------------------+
//|                                             EA-09_ATR_Breakout.mq5|
//|                        ATR Volatility Breakout Expert Advisor     |
//+------------------------------------------------------------------+
#property strict
#property version   "1.00"
#property description "EA-09 - ATR Volatility Breakout"
#property description "ATR-based price channel breakout strategy for MT5"

//--- Trade class
#include <Trade/Trade.mqh>

CTrade trade;

//+------------------------------------------------------------------+
//| INPUT PARAMETERS                                                 |
//+------------------------------------------------------------------+
input ulong  MagicNumber          = 9009;
input double LotSize              = 0.10;

input int    ATR_Period           = 14;
input int    BreakoutLookback     = 20;
input double BreakoutBufferATR    = 0.10;
input double ATR_SL_Multiplier    = 1.50;
input double RiskRewardRatio      = 1.80;

input bool   UseTrailingStop      = false;
input double TrailingATRMultiplier = 1.50;

input int    MaxSpreadPoints      = 50;

input bool   UseTradingHours      = false;
input int    StartHour            = 0;
input int    EndHour              = 23;

//+------------------------------------------------------------------+
//| GLOBAL VARIABLES                                                 |
//+------------------------------------------------------------------+
int      atrHandle = INVALID_HANDLE;
datetime lastBarTime = 0;

//+------------------------------------------------------------------+
//| Normalize price according to symbol digits                       |
//+------------------------------------------------------------------+
double NormalizePrice(const double price)
{
   return NormalizeDouble(price, (int)_Digits);
}

//+------------------------------------------------------------------+
//| Normalize lot according to broker requirements                    |
//+------------------------------------------------------------------+
double CalculateLotSize()
{
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(minLot <= 0.0 || maxLot <= 0.0 || lotStep <= 0.0)
      return 0.0;

   double lot = LotSize;

   if(lot < minLot)
      lot = minLot;

   if(lot > maxLot)
      lot = maxLot;

   lot = MathFloor(lot / lotStep) * lotStep;

   if(lot < minLot)
      lot = minLot;

   if(lot > maxLot)
      lot = maxLot;

   int volumeDigits = 0;
   double stepCheck = lotStep;

   while(volumeDigits < 8 && MathAbs(stepCheck - MathRound(stepCheck)) > 0.00000001)
   {
      stepCheck *= 10.0;
      volumeDigits++;
   }

   return NormalizeDouble(lot, volumeDigits);
}

//+------------------------------------------------------------------+
//| Detect new bar                                                   |
//+------------------------------------------------------------------+
bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, _Period, 0);

   if(currentBarTime <= 0)
      return false;

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| Get ATR value                                                    |
//+------------------------------------------------------------------+
double GetATR(const int shift)
{
   if(atrHandle == INVALID_HANDLE)
      return 0.0;

   double atrValue[1];

   ResetLastError();

   int copied = CopyBuffer(
      atrHandle,
      0,
      shift,
      1,
      atrValue
   );

   if(copied != 1)
      return 0.0;

   if(atrValue[0] <= 0.0)
      return 0.0;

   return atrValue[0];
}

//+------------------------------------------------------------------+
//| Get previous breakout high                                       |
//| Signal candle = bar 1                                            |
//| Range uses bars 2 ... Lookback+1                                 |
//+------------------------------------------------------------------+
double GetBreakoutHigh()
{
   if(BreakoutLookback < 1)
      return 0.0;

   MqlRates rates[];

   int copied = CopyRates(
      _Symbol,
      _Period,
      2,
      BreakoutLookback,
      rates
   );

   if(copied != BreakoutLookback)
      return 0.0;

   double highest = rates[0].high;

   for(int i = 1; i < copied; i++)
   {
      if(rates[i].high > highest)
         highest = rates[i].high;
   }

   return highest;
}

//+------------------------------------------------------------------+
//| Get previous breakout low                                        |
//| Signal candle = bar 1                                            |
//| Range uses bars 2 ... Lookback+1                                 |
//+------------------------------------------------------------------+
double GetBreakoutLow()
{
   if(BreakoutLookback < 1)
      return 0.0;

   MqlRates rates[];

   int copied = CopyRates(
      _Symbol,
      _Period,
      2,
      BreakoutLookback,
      rates
   );

   if(copied != BreakoutLookback)
      return 0.0;

   double lowest = rates[0].low;

   for(int i = 1; i < copied; i++)
   {
      if(rates[i].low < lowest)
         lowest = rates[i].low;
   }

   return lowest;
}

//+------------------------------------------------------------------+
//| Check whether this EA already has a position                     |
//+------------------------------------------------------------------+
bool HasOpenPosition()
{
   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && (ulong)magic == MagicNumber)
         return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| Check trading hours                                              |
//+------------------------------------------------------------------+
bool IsTradingHour()
{
   if(!UseTradingHours)
      return true;

   if(StartHour < 0 || StartHour > 23)
      return false;

   if(EndHour < 0 || EndHour > 23)
      return false;

   MqlDateTime timeStruct;
   TimeToStruct(TimeCurrent(), timeStruct);

   int currentHour = timeStruct.hour;

   if(StartHour == EndHour)
      return true;

   if(StartHour < EndHour)
   {
      if(currentHour >= StartHour && currentHour <= EndHour)
         return true;

      return false;
   }

   // Overnight trading window, e.g. 22 -> 5
   if(currentHour >= StartHour || currentHour <= EndHour)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Check spread                                                     |
//+------------------------------------------------------------------+
bool IsSpreadAllowed()
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   if(tick.bid <= 0.0 || tick.ask <= 0.0)
      return false;

   double spreadPoints = (tick.ask - tick.bid) / _Point;

   if(spreadPoints > (double)MaxSpreadPoints)
      return false;

   return true;
}

//+------------------------------------------------------------------+
//| Get minimum broker stop distance                                 |
//+------------------------------------------------------------------+
double GetMinimumStopDistance()
{
   long stopsLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);

   if(stopsLevel < 0)
      stopsLevel = 0;

   return (double)stopsLevel * _Point;
}

//+------------------------------------------------------------------+
//| Open BUY                                                         |
//+------------------------------------------------------------------+
bool OpenBuy(const double atr)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
   {
      Print("BUY rejected: invalid lot size.");
      return false;
   }

   double entry = tick.ask;

   if(entry <= 0.0)
      return false;

   double stopDistance = atr * ATR_SL_Multiplier;

   if(stopDistance <= 0.0)
      return false;

   double minimumDistance = GetMinimumStopDistance();

   if(stopDistance < minimumDistance)
      stopDistance = minimumDistance;

   if(stopDistance <= 0.0)
      return false;

   double sl = entry - stopDistance;
   double risk = entry - sl;

   if(risk <= 0.0)
      return false;

   double tp = entry + (risk * RiskRewardRatio);

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   // Verify minimum distance after normalization
   if((entry - sl) < minimumDistance)
   {
      Print("BUY rejected: Stop Loss is below broker minimum distance.");
      return false;
   }

   if((tp - entry) < minimumDistance)
   {
      Print("BUY rejected: Take Profit is below broker minimum distance.");
      return false;
   }

   ResetLastError();

   bool result = trade.Buy(
      lot,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-09 ATR Volatility Breakout BUY"
   );

   if(!result)
   {
      Print(
         "BUY order failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Open SELL                                                        |
//+------------------------------------------------------------------+
bool OpenSell(const double atr)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
   {
      Print("SELL rejected: invalid lot size.");
      return false;
   }

   double entry = tick.bid;

   if(entry <= 0.0)
      return false;

   double stopDistance = atr * ATR_SL_Multiplier;

   if(stopDistance <= 0.0)
      return false;

   double minimumDistance = GetMinimumStopDistance();

   if(stopDistance < minimumDistance)
      stopDistance = minimumDistance;

   if(stopDistance <= 0.0)
      return false;

   double sl = entry + stopDistance;
   double risk = sl - entry;

   if(risk <= 0.0)
      return false;

   double tp = entry - (risk * RiskRewardRatio);

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   // Verify minimum distance after normalization
   if((sl - entry) < minimumDistance)
   {
      Print("SELL rejected: Stop Loss is below broker minimum distance.");
      return false;
   }

   if((entry - tp) < minimumDistance)
   {
      Print("SELL rejected: Take Profit is below broker minimum distance.");
      return false;
   }

   ResetLastError();

   bool result = trade.Sell(
      lot,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-09 ATR Volatility Breakout SELL"
   );

   if(!result)
   {
      Print(
         "SELL order failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Manage optional ATR trailing stop                                |
//+------------------------------------------------------------------+
void ManageTrailingStop()
{
   if(!UseTrailingStop)
      return;

   if(TrailingATRMultiplier <= 0.0)
      return;

   double atr = GetATR(1);

   if(atr <= 0.0)
      return;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double minimumDistance = GetMinimumStopDistance();

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol || (ulong)magic != MagicNumber)
         continue;

      long positionType = PositionGetInteger(POSITION_TYPE);

      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);

      //--- BUY trailing
      if(positionType == POSITION_TYPE_BUY)
      {
         if(tick.bid <= openPrice)
            continue;

         double newSL = tick.bid - (atr * TrailingATRMultiplier);

         if(minimumDistance > 0.0)
         {
            double maxAllowedSL = tick.bid - minimumDistance;

            if(newSL > maxAllowedSL)
               newSL = maxAllowedSL;
         }

         newSL = NormalizePrice(newSL);

         if(newSL <= openPrice)
            continue;

         if(currentSL > 0.0 && newSL <= currentSL)
            continue;

         ResetLastError();

         if(!trade.PositionModify(ticket, newSL, currentTP))
         {
            Print(
               "BUY trailing modification failed. Ticket=",
               ticket,
               " Retcode=",
               trade.ResultRetcode(),
               " Description=",
               trade.ResultRetcodeDescription()
            );
         }
      }

      //--- SELL trailing
      else if(positionType == POSITION_TYPE_SELL)
      {
         if(tick.ask >= openPrice)
            continue;

         double newSL = tick.ask + (atr * TrailingATRMultiplier);

         if(minimumDistance > 0.0)
         {
            double minAllowedSL = tick.ask + minimumDistance;

            if(newSL < minAllowedSL)
               newSL = minAllowedSL;
         }

         newSL = NormalizePrice(newSL);

         if(newSL >= openPrice)
            continue;

         if(currentSL > 0.0 && newSL >= currentSL)
            continue;

         ResetLastError();

         if(!trade.PositionModify(ticket, newSL, currentTP))
         {
            Print(
               "SELL trailing modification failed. Ticket=",
               ticket,
               " Retcode=",
               trade.ResultRetcode(),
               " Description=",
               trade.ResultRetcodeDescription()
            );
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Validate input parameters                                        |
//+------------------------------------------------------------------+
bool ValidateInputs()
{
   if(MagicNumber == 0)
   {
      Print("Invalid MagicNumber.");
      return false;
   }

   if(LotSize <= 0.0)
   {
      Print("Invalid LotSize.");
      return false;
   }

   if(ATR_Period < 1)
   {
      Print("Invalid ATR_Period.");
      return false;
   }

   if(BreakoutLookback < 1)
   {
      Print("Invalid BreakoutLookback.");
      return false;
   }

   if(BreakoutBufferATR < 0.0)
   {
      Print("Invalid BreakoutBufferATR.");
      return false;
   }

   if(ATR_SL_Multiplier <= 0.0)
   {
      Print("Invalid ATR_SL_Multiplier.");
      return false;
   }

   if(RiskRewardRatio <= 0.0)
   {
      Print("Invalid RiskRewardRatio.");
      return false;
   }

   if(TrailingATRMultiplier <= 0.0 && UseTrailingStop)
   {
      Print("Invalid TrailingATRMultiplier.");
      return false;
   }

   if(MaxSpreadPoints < 0)
   {
      Print("Invalid MaxSpreadPoints.");
      return false;
   }

   if(StartHour < 0 || StartHour > 23)
   {
      Print("Invalid StartHour.");
      return false;
   }

   if(EndHour < 0 || EndHour > 23)
   {
      Print("Invalid EndHour.");
      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   if(!ValidateInputs())
      return INIT_PARAMETERS_INCORRECT;

   //--- Create native MQL5 ATR indicator handle
   atrHandle = iATR(
      _Symbol,
      _Period,
      ATR_Period
   );

   if(atrHandle == INVALID_HANDLE)
   {
      Print(
         "Failed to create ATR handle. Error=",
         GetLastError()
      );

      return INIT_FAILED;
   }

   //--- Configure CTrade
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.SetAsyncMode(false);

   //--- Initialize new-bar detector
   lastBarTime = iTime(_Symbol, _Period, 0);

   Print(
      "EA-09 ATR Volatility Breakout initialized successfully. ",
      "Magic=",
      MagicNumber,
      " ATR Period=",
      ATR_Period,
      " Lookback=",
      BreakoutLookback
   );

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(atrHandle != INVALID_HANDLE)
   {
      IndicatorRelease(atrHandle);
      atrHandle = INVALID_HANDLE;
   }
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   //--- Manage an existing trade on every tick if enabled
   ManageTrailingStop();

   //--- Entry logic ONLY on a newly formed bar
   if(!IsNewBar())
      return;

   //--- Never trade without sufficient historical bars
   int requiredBars = BreakoutLookback + ATR_Period + 10;

   if(Bars(_Symbol, _Period) < requiredBars)
      return;

   //--- One position per symbol + magic number
   if(HasOpenPosition())
      return;

   //--- Trading hours filter
   if(!IsTradingHour())
      return;

   //--- Spread filter
   if(!IsSpreadAllowed())
      return;

   //--- ATR from the latest CLOSED candle
   double atr = GetATR(1);

   if(atr <= 0.0)
      return;

   //--- Previous breakout channel
   //--- Signal candle is bar 1.
   //--- Range consists exclusively of bars 2 ... Lookback+1.
   double breakoutHigh = GetBreakoutHigh();
   double breakoutLow  = GetBreakoutLow();

   if(breakoutHigh <= 0.0 || breakoutLow <= 0.0)
      return;

   //--- Get latest CLOSED candle
   MqlRates signalBar[1];

   int copied = CopyRates(
      _Symbol,
      _Period,
      1,
      1,
      signalBar
   );

   if(copied != 1)
      return;

   double signalClose = signalBar[0].close;

   if(signalClose <= 0.0)
      return;

   //--- ATR-based breakout buffer
   double breakoutBuffer = atr * BreakoutBufferATR;

   //--- BUY breakout
   bool buySignal =
      (signalClose > breakoutHigh) &&
      (signalClose > breakoutHigh + breakoutBuffer);

   //--- SELL breakout
   bool sellSignal =
      (signalClose < breakoutLow) &&
      (signalClose < breakoutLow - breakoutBuffer);

   //--- Execute only one direction
   if(buySignal && !sellSignal)
   {
      OpenBuy(atr);
      return;
   }

   if(sellSignal && !buySignal)
   {
      OpenSell(atr);
      return;
   }
}
