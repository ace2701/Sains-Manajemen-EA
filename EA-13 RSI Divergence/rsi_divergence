//+------------------------------------------------------------------+
//| BULLISH DIVERGENCE                                               |
//+------------------------------------------------------------------+

bool DetectBullishDivergence(PivotInfo &recent, PivotInfo &previous)
{
   if(!FindRecentPivotLow(recent))
      return false;

   if(!FindPreviousPivotLow(recent, previous))
      return false;

   if(recent.shift >= previous.shift)
      return false;

   //--- Price must make a lower low.
   if(recent.price >= previous.price)
      return false;

   //--- RSI must make a higher low.
   if(recent.rsi <= previous.rsi)
      return false;

   //--- Price divergence percentage.
   if(previous.price <= 0.0)
      return false;

   double priceDifferencePercent =
      ((previous.price - recent.price) / previous.price) * 100.0;

   if(priceDifferencePercent < MinimumPriceDifferencePercent)
      return false;

   //--- RSI divergence.
   double rsiDifference = recent.rsi - previous.rsi;

   if(rsiDifference < MinimumRSIDifference)
      return false;

   if(UseDivergenceStrengthFilter)
   {
      double score = CalculateBullishScore(
         previous.price,
         recent.price,
         previous.rsi,
         recent.rsi
      );

      if(score < MinimumDivergenceScore)
         return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| BEARISH DIVERGENCE                                               |
//+------------------------------------------------------------------+

bool DetectBearishDivergence(PivotInfo &recent, PivotInfo &previous)
{
   if(!FindRecentPivotHigh(recent))
      return false;

   if(!FindPreviousPivotHigh(recent, previous))
      return false;

   if(recent.shift >= previous.shift)
      return false;

   //--- Price must make a higher high.
   if(recent.price <= previous.price)
      return false;

   //--- RSI must make a lower high.
   if(recent.rsi >= previous.rsi)
      return false;

   //--- Price divergence percentage.
   if(previous.price <= 0.0)
      return false;

   double priceDifferencePercent =
      ((recent.price - previous.price) / previous.price) * 100.0;

   if(priceDifferencePercent < MinimumPriceDifferencePercent)
      return false;

   //--- RSI divergence.
   double rsiDifference = previous.rsi - recent.rsi;

   if(rsiDifference < MinimumRSIDifference)
      return false;

   if(UseDivergenceStrengthFilter)
   {
      double score = CalculateBearishScore(
         previous.price,
         recent.price,
         previous.rsi,
         recent.rsi
      );

      if(score < MinimumDivergenceScore)
         return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| BULLISH DIVERGENCE SCORE                                         |
//+------------------------------------------------------------------+

double CalculateBullishScore(
   const double previousPrice,
   const double recentPrice,
   const double previousRSI,
   const double recentRSI)
{
   if(previousPrice <= 0.0)
      return 0.0;

   double priceScore =
      ((previousPrice - recentPrice) / previousPrice) * 100.0;

   double rsiScore = recentRSI - previousRSI;

   return priceScore + rsiScore;
}

//+------------------------------------------------------------------+
//| BEARISH DIVERGENCE SCORE                                         |
//+------------------------------------------------------------------+

double CalculateBearishScore(
   const double previousPrice,
   const double recentPrice,
   const double previousRSI,
   const double recentRSI)
{
   if(previousPrice <= 0.0)
      return 0.0;

   double priceScore =
      ((recentPrice - previousPrice) / previousPrice) * 100.0;

   double rsiScore = previousRSI - recentRSI;

   return priceScore + rsiScore;
}

//+------------------------------------------------------------------+
//| CHECK CONSUMED DIVERGENCE                                        |
//+------------------------------------------------------------------+

bool IsDivergenceConsumed(
   const bool bullish,
   const datetime recentTime,
   const datetime previousTime)
{
   if(bullish)
   {
      if(consumedBullRecent == recentTime &&
         consumedBullPrevious == previousTime)
      {
         return true;
      }
   }
   else
   {
      if(consumedBearRecent == recentTime &&
         consumedBearPrevious == previousTime)
      {
         return true;
      }
   }

   return false;
}

//+------------------------------------------------------------------+
//| OPEN BUY                                                         |
//+------------------------------------------------------------------+

bool OpenBuy(const double recentPivotLow)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double entryPrice = tick.ask;

   double sl = CalculateStopLoss(true, entryPrice, recentPivotLow);

   if(sl <= 0.0)
      return false;

   double risk = entryPrice - sl;

   if(risk <= 0.0)
      return false;

   double maxRisk = MaxStopLossPoints * _Point;

   if(risk > maxRisk)
      return false;

   double tp = CalculateTakeProfit(true, entryPrice, sl);

   if(tp <= entryPrice)
      return false;

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   if(!AreStopsValid(true, entryPrice, sl, tp))
      return false;

   double volume = CalculateLotSize();

   if(volume <= 0.0)
      return false;

   ResetLastError();

   bool result = trade.Buy(
      volume,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-13 RSI Bullish Divergence"
   );

   if(!result)
   {
      Print(
         "BUY failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| OPEN SELL                                                        |
//+------------------------------------------------------------------+

bool OpenSell(const double recentPivotHigh)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double entryPrice = tick.bid;

   double sl = CalculateStopLoss(false, entryPrice, recentPivotHigh);

   if(sl <= 0.0)
      return false;

   double risk = sl - entryPrice;

   if(risk <= 0.0)
      return false;

   double maxRisk = MaxStopLossPoints * _Point;

   if(risk > maxRisk)
      return false;

   double tp = CalculateTakeProfit(false, entryPrice, sl);

   if(tp >= entryPrice)
      return false;

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   if(!AreStopsValid(false, entryPrice, sl, tp))
      return false;

   double volume = CalculateLotSize();

   if(volume <= 0.0)
      return false;

   ResetLastError();

   bool result = trade.Sell(
      volume,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-13 RSI Bearish Divergence"
   );

   if(!result)
   {
      Print(
         "SELL failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| CALCULATE STOP LOSS                                              |
//+------------------------------------------------------------------+

double CalculateStopLoss(
   const bool isBuy,
   const double entryPrice,
   const double pivotPrice)
{
   double buffer = StopBufferPoints * _Point;

   double sl;

   if(isBuy)
      sl = pivotPrice - buffer;
   else
      sl = pivotPrice + buffer;

   //--- Respect broker stop level.
   long stopsLevel = 0;

   if(SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL, stopsLevel))
   {
      double minimumDistance = (double)stopsLevel * _Point;

      if(isBuy)
      {
         double minimumSL = entryPrice - minimumDistance;

         if(sl > minimumSL)
            sl = minimumSL;
      }
      else
      {
         double minimumSL = entryPrice + minimumDistance;

         if(sl < minimumSL)
            sl = minimumSL;
      }
   }

   return NormalizePrice(sl);
}

//+------------------------------------------------------------------+
//| CALCULATE TAKE PROFIT                                            |
//+------------------------------------------------------------------+

double CalculateTakeProfit(
   const bool isBuy,
   const double entryPrice,
   const double sl)
{
   double risk;

   if(isBuy)
      risk = entryPrice - sl;
   else
      risk = sl - entryPrice;

   if(risk <= 0.0)
      return 0.0;

   double tp;

   if(isBuy)
      tp = entryPrice + risk * RiskRewardRatio;
   else
      tp = entryPrice - risk * RiskRewardRatio;

   return NormalizePrice(tp);
}

//+------------------------------------------------------------------+
//| VALIDATE STOPS                                                   |
//+------------------------------------------------------------------+

bool AreStopsValid(
   const bool isBuy,
   const double entryPrice,
   const double sl,
   const double tp)
{
   if(sl <= 0.0 || tp <= 0.0)
      return false;

   long stopsLevel = 0;

   if(!SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL, stopsLevel))
      return false;

   double minimumDistance = (double)stopsLevel * _Point;

   if(isBuy)
   {
      if(sl >= entryPrice)
         return false;

      if(tp <= entryPrice)
         return false;

      if((entryPrice - sl) < minimumDistance)
         return false;

      if((tp - entryPrice) < minimumDistance)
         return false;
   }
   else
   {
      if(sl <= entryPrice)
         return false;

      if(tp >= entryPrice)
         return false;

      if((sl - entryPrice) < minimumDistance)
         return false;

      if((entryPrice - tp) < minimumDistance)
         return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| CALCULATE LOT SIZE                                               |
//+------------------------------------------------------------------+

double CalculateLotSize()
{
   double minimumLot = 0.0;
   double maximumLot = 0.0;
   double volumeStep = 0.0;

   if(!SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN, minimumLot))
      return 0.0;

   if(!SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX, maximumLot))
      return 0.0;

   if(!SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP, volumeStep))
      return 0.0;

   if(volumeStep <= 0.0)
      return 0.0;

   double volume = LotSize;

   if(volume < minimumLot)
      volume = minimumLot;

   if(volume > maximumLot)
      volume = maximumLot;

   volume = MathFloor(volume / volumeStep + 0.0000001) * volumeStep;

   if(volume < minimumLot)
      volume = minimumLot;

   if(volume > maximumLot)
      volume = maximumLot;

   return NormalizeVolume(volume, volumeStep);
}

//+------------------------------------------------------------------+
//| NORMALIZE VOLUME                                                 |
//+------------------------------------------------------------------+

double NormalizeVolume(
   const double volume,
   const double step)
{
   if(step <= 0.0)
      return volume;

   int digits = 0;
   double testStep = step;

   while(digits < 8 && MathAbs(testStep - MathRound(testStep)) > 0.00000001)
   {
      testStep *= 10.0;
      digits++;
   }

   return NormalizeDouble(volume, digits);
}

//+------------------------------------------------------------------+
//| NORMALIZE PRICE                                                  |
//+------------------------------------------------------------------+

double NormalizePrice(const double price)
{
   return NormalizeDouble(price, (int)_Digits);
}

//+------------------------------------------------------------------+
//| CHECK OPEN POSITION                                              |
//+------------------------------------------------------------------+

bool HasOpenPosition()
{
   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol &&
         magic == (long)MagicNumber)
      {
         return true;
      }
   }

   return false;
}

//+------------------------------------------------------------------+
//| SPREAD FILTER                                                    |
//+------------------------------------------------------------------+

bool IsSpreadAcceptable()
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double spreadPoints = (tick.ask - tick.bid) / _Point;

   return (spreadPoints <= (double)MaxSpreadPoints);
}

//+------------------------------------------------------------------+
//| TRADING HOURS                                                    |
//+------------------------------------------------------------------+

bool IsTradingTime()
{
   if(!UseTradingHours)
      return true;

   MqlDateTime currentTime;

   TimeToStruct(TimeCurrent(), currentTime);

   int hour = currentTime.hour;

   if(StartHour == EndHour)
      return true;

   if(StartHour < EndHour)
   {
      if(hour >= StartHour && hour < EndHour)
         return true;

      return false;
   }

   //--- Overnight trading window.
   if(hour >= StartHour || hour < EndHour)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| POSITION MANAGEMENT                                              |
//+------------------------------------------------------------------+

void ManagePositions()
{
   if(!UseRSIExit)
      return;

   if(rsiHandle == INVALID_HANDLE)
      return;

   if(!HasOpenPosition())
      return;

   double rsi[];
   ArrayResize(rsi, 3);
   ArraySetAsSeries(rsi, true);

   int copied = CopyBuffer(rsiHandle, 0, 0, 3, rsi);

   if(copied < 2)
      return;

   double closedRSI = rsi[1];

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic    = PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol ||
         magic != (long)MagicNumber)
      {
         continue;
      }

      ENUM_POSITION_TYPE positionType =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      if(positionType == POSITION_TYPE_BUY)
      {
         if(closedRSI >= UpperExitLevel)
         {
            if(!trade.PositionClose(ticket))
            {
               Print(
                  "Failed to close BUY by RSI exit. Retcode=",
                  trade.ResultRetcode(),
                  " Description=",
                  trade.ResultRetcodeDescription()
               );
            }
         }
      }
      else if(positionType == POSITION_TYPE_SELL)
      {
         if(closedRSI <= LowerExitLevel)
         {
            if(!trade.PositionClose(ticket))
            {
               Print(
                  "Failed to close SELL by RSI exit. Retcode=",
                  trade.ResultRetcode(),
                  " Description=",
                  trade.ResultRetcodeDescription()
               );
            }
         }
      }
   }
}
