//+------------------------------------------------------------------+
//|                                                EA-13 RSI Divergence.mq5
//|                         Non-Repainting RSI Divergence Expert Advisor
//+------------------------------------------------------------------+
#property strict
#property version   "1.00"
#property description "EA-13 - RSI Divergence"
#property description "Non-repainting regular RSI divergence strategy"

//--- Trading
#include <Trade/Trade.mqh>

CTrade trade;

//+------------------------------------------------------------------+
//| INPUT PARAMETERS                                                 |
//+------------------------------------------------------------------+

//--- General
input ulong  MagicNumber                    = 9013;   // Unique magic number
input double LotSize                        = 0.10;   // Fixed lot size
input int    MaxSpreadPoints                = 50;     // Maximum allowed spread

//--- RSI
input int    RSI_Period                     = 14;     // RSI period

//--- Pivot Detection
input int    PivotStrength                  = 2;      // Pivot confirmation strength
input int    MinimumPivotDistance            = 3;      // Minimum bars between pivots
input int    MaximumPivotDistance            = 50;     // Maximum bars between pivots

//--- Divergence
input double MinimumPriceDifferencePercent   = 0.05;   // Minimum price divergence %
input double MinimumRSIDifference             = 2.0;    // Minimum RSI divergence
input int    MaxSignalAgeBars                = 3;      // Maximum age of recent pivot

//--- Risk Management
input int    StopBufferPoints                = 50;     // SL buffer in points
input int    MaxStopLossPoints               = 500;    // Maximum SL distance
input double RiskRewardRatio                 = 1.50;   // Risk/reward ratio

//--- Optional Exit
input bool   UseRSIExit                      = false;  // Enable RSI exit
input double UpperExitLevel                  = 70.0;   // BUY RSI exit level
input double LowerExitLevel                  = 30.0;   // SELL RSI exit level

//--- Optional Filter
input bool   UseDivergenceStrengthFilter     = false;  // Enable strength filter
input double MinimumDivergenceScore         = 0.0;    // Minimum divergence score

//--- Trading Hours
input bool   UseTradingHours                 = false;  // Restrict trading hours
input int    StartHour                       = 0;      // Trading start hour
input int    EndHour                         = 23;     // Trading end hour

//+------------------------------------------------------------------+
//| GLOBAL VARIABLES                                                 |
//+------------------------------------------------------------------+

int      rsiHandle = INVALID_HANDLE;
datetime lastBarTime = 0;

datetime consumedBullRecent = 0;
datetime consumedBullPrevious = 0;

datetime consumedBearRecent = 0;
datetime consumedBearPrevious = 0;

//+------------------------------------------------------------------+
//| STRUCTURE                                                        |
//+------------------------------------------------------------------+

struct PivotInfo
{
   int      shift;
   datetime time;
   double   price;
   double   rsi;
};

//+------------------------------------------------------------------+
//| EXPERT INITIALIZATION                                            |
//+------------------------------------------------------------------+

int OnInit()
{
   if(RSI_Period < 2)
   {
      Print("Invalid RSI_Period.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   if(PivotStrength < 1)
   {
      Print("Invalid PivotStrength.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   if(MinimumPivotDistance < 1)
   {
      Print("Invalid MinimumPivotDistance.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   if(MaximumPivotDistance < MinimumPivotDistance)
   {
      Print("MaximumPivotDistance must be >= MinimumPivotDistance.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   if(RiskRewardRatio <= 0.0)
   {
      Print("RiskRewardRatio must be greater than zero.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   if(LotSize <= 0.0)
   {
      Print("LotSize must be greater than zero.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   rsiHandle = iRSI(_Symbol, PERIOD_CURRENT, RSI_Period, PRICE_CLOSE);

   if(rsiHandle == INVALID_HANDLE)
   {
      Print("Failed to create RSI handle. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.SetAsyncMode(false);

   lastBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| EXPERT DEINITIALIZATION                                          |
//+------------------------------------------------------------------+

void OnDeinit(const int reason)
{
   if(rsiHandle != INVALID_HANDLE)
   {
      IndicatorRelease(rsiHandle);
      rsiHandle = INVALID_HANDLE;
   }
}

//+------------------------------------------------------------------+
//| EXPERT TICK                                                      |
//+------------------------------------------------------------------+

void OnTick()
{
   ManagePositions();

   if(!IsNewBar())
      return;

   if(Bars(_Symbol, PERIOD_CURRENT) < 100)
      return;

   if(!IsTradingTime())
      return;

   if(HasOpenPosition())
      return;

   if(!IsSpreadAcceptable())
      return;

   PivotInfo recentLow;
   PivotInfo previousLow;

   PivotInfo recentHigh;
   PivotInfo previousHigh;

   bool bullish = DetectBullishDivergence(recentLow, previousLow);
   bool bearish = DetectBearishDivergence(recentHigh, previousHigh);

   //--- If both occur simultaneously, use the more recent pivot signal.
   if(bullish && bearish)
   {
      if(recentLow.time > recentHigh.time)
         bearish = false;
      else
         bullish = false;
   }

   if(bullish)
   {
      if(!IsDivergenceConsumed(true, recentLow.time, previousLow.time))
      {
         if(OpenBuy(recentLow.price))
         {
            consumedBullRecent   = recentLow.time;
            consumedBullPrevious = previousLow.time;
         }
      }

      return;
   }

   if(bearish)
   {
      if(!IsDivergenceConsumed(false, recentHigh.time, previousHigh.time))
      {
         if(OpenSell(recentHigh.price))
         {
            consumedBearRecent   = recentHigh.time;
            consumedBearPrevious = previousHigh.time;
         }
      }
   }
}

//+------------------------------------------------------------------+
//| NEW BAR DETECTION                                                |
//+------------------------------------------------------------------+

bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);

   if(currentBarTime == 0)
      return false;

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| PIVOT LOW                                                        |
//+------------------------------------------------------------------+

bool IsPivotLow(const MqlRates &rates[], const int shift, const int strength)
{
   int total = ArraySize(rates);

   if(shift <= strength)
      return false;

   if(shift + strength >= total)
      return false;

   double pivotLow = rates[shift].low;

   for(int i = 1; i <= strength; i++)
   {
      //--- Newer candles
      if(pivotLow >= rates[shift - i].low)
         return false;

      //--- Older candles
      if(pivotLow >= rates[shift + i].low)
         return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| PIVOT HIGH                                                       |
//+------------------------------------------------------------------+

bool IsPivotHigh(const MqlRates &rates[], const int shift, const int strength)
{
   int total = ArraySize(rates);

   if(shift <= strength)
      return false;

   if(shift + strength >= total)
      return false;

   double pivotHigh = rates[shift].high;

   for(int i = 1; i <= strength; i++)
   {
      //--- Newer candles
      if(pivotHigh <= rates[shift - i].high)
         return false;

      //--- Older candles
      if(pivotHigh <= rates[shift + i].high)
         return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| GET RSI DATA                                                     |
//+------------------------------------------------------------------+

bool GetRSIData(const int count, double &rsi[])
{
   if(rsiHandle == INVALID_HANDLE)
      return false;

   if(count <= 0)
      return false;

   ArrayResize(rsi, count);
   ArraySetAsSeries(rsi, true);

   ResetLastError();

   int copied = CopyBuffer(rsiHandle, 0, 0, count, rsi);

   if(copied != count)
   {
      int errorCode = GetLastError();

      if(errorCode != 0)
         Print("CopyBuffer RSI failed. Error: ", errorCode);

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| FIND RECENT PIVOT LOW                                            |
//+------------------------------------------------------------------+

bool FindRecentPivotLow(PivotInfo &pivot)
{
   int barsAvailable = Bars(_Symbol, PERIOD_CURRENT);

   if(barsAvailable < 50)
      return false;

   int requiredBars = MathMin(barsAvailable, 5000);

   MqlRates rates[];
   ArraySetAsSeries(rates, true);

   int copiedRates = CopyRates(_Symbol, PERIOD_CURRENT, 0, requiredBars, rates);

   if(copiedRates <= PivotStrength + 2)
      return false;

   double rsi[];
   if(!GetRSIData(copiedRates, rsi))
      return false;

   int firstShift = PivotStrength + 1;
   int lastShift  = MathMin(MaxSignalAgeBars, copiedRates - PivotStrength - 1);

   if(lastShift < firstShift)
      return false;

   for(int shift = firstShift; shift <= lastShift; shift++)
   {
      if(!IsPivotLow(rates, shift, PivotStrength))
         continue;

      pivot.shift = shift;
      pivot.time  = rates[shift].time;
      pivot.price = rates[shift].low;
      pivot.rsi   = rsi[shift];

      if(pivot.rsi < 0.0 || pivot.rsi > 100.0)
         continue;

      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| FIND PREVIOUS PIVOT LOW                                          |
//+------------------------------------------------------------------+

bool FindPreviousPivotLow(const PivotInfo &recent, PivotInfo &previous)
{
   int barsAvailable = Bars(_Symbol, PERIOD_CURRENT);

   if(barsAvailable < 50)
      return false;

   int requiredBars = MathMin(barsAvailable, 5000);

   MqlRates rates[];
   ArraySetAsSeries(rates, true);

   int copiedRates = CopyRates(_Symbol, PERIOD_CURRENT, 0, requiredBars, rates);

   if(copiedRates <= recent.shift + PivotStrength + 1)
      return false;

   double rsi[];
   if(!GetRSIData(copiedRates, rsi))
      return false;

   int firstShift = recent.shift + MinimumPivotDistance;
   int lastShift  = recent.shift + MaximumPivotDistance;

   lastShift = MathMin(lastShift, copiedRates - PivotStrength - 1);

   if(firstShift > lastShift)
      return false;

   for(int shift = firstShift; shift <= lastShift; shift++)
   {
      if(!IsPivotLow(rates, shift, PivotStrength))
         continue;

      previous.shift = shift;
      previous.time  = rates[shift].time;
      previous.price = rates[shift].low;
      previous.rsi   = rsi[shift];

      if(previous.rsi < 0.0 || previous.rsi > 100.0)
         continue;

      return true;
   }

   return false;
}

