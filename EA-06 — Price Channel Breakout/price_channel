//+------------------------------------------------------------------+
//| EA-06 Price Channel Breakout - Improved                         |
//+------------------------------------------------------------------+
#property copyright "OpenAI"
#property version   "2.00"
#property description "Price Channel Breakout with EMA Trend and ATR Confirmation"

#include <Trade/Trade.mqh>

CTrade trade;

//--- Main inputs
input int    ChannelPeriod          = 20;
input int    ATRPeriod              = 14;

//--- Filters
input double ATR_MinRangeMultiplier = 0.7;
input int    EMAPeriod              = 50;

//--- Risk management
input double ATR_SL_Multiplier      = 1.5;
input double RiskRewardRatio        = 2.5;
input double FixedLotSize           = 0.01;

//--- Trading conditions
input int    MaximumSpread          = 30;
input long   MagicNumber            = 2026091306;

//--- Indicator handles
int atrHandle = INVALID_HANDLE;
int emaHandle = INVALID_HANDLE;

//--- New bar control
datetime lastBarTime = 0;

//+------------------------------------------------------------------+
//| Expert initialization                                             |
//+------------------------------------------------------------------+
int OnInit()
{
   if(ChannelPeriod < 2)
      return INIT_PARAMETERS_INCORRECT;

   if(ATRPeriod < 2)
      return INIT_PARAMETERS_INCORRECT;

   if(EMAPeriod < 2)
      return INIT_PARAMETERS_INCORRECT;

   if(ATR_MinRangeMultiplier <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(ATR_SL_Multiplier <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(RiskRewardRatio <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   if(FixedLotSize <= 0.0)
      return INIT_PARAMETERS_INCORRECT;

   //--- ATR
   atrHandle = iATR(_Symbol, _Period, ATRPeriod);

   if(atrHandle == INVALID_HANDLE)
   {
      Print("Failed to create ATR handle. Error: ", GetLastError());
      return INIT_FAILED;
   }

   //--- EMA
   emaHandle = iMA(
      _Symbol,
      _Period,
      EMAPeriod,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   if(emaHandle == INVALID_HANDLE)
   {
      Print("Failed to create EMA handle. Error: ", GetLastError());

      IndicatorRelease(atrHandle);
      atrHandle = INVALID_HANDLE;

      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);

   //--- Prevent immediate trade after EA initialization
   lastBarTime = iTime(_Symbol, _Period, 0);

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                           |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(atrHandle != INVALID_HANDLE)
   {
      IndicatorRelease(atrHandle);
      atrHandle = INVALID_HANDLE;
   }

   if(emaHandle != INVALID_HANDLE)
   {
      IndicatorRelease(emaHandle);
      emaHandle = INVALID_HANDLE;
   }
}

//+------------------------------------------------------------------+
//| Expert tick                                                       |
//+------------------------------------------------------------------+
void OnTick()
{
   //--- Only process once per new candle
   if(!IsNewBar())
      return;

   //--- Enough historical data
   int requiredBars = ChannelPeriod + EMAPeriod + ATRPeriod + 10;

   if(Bars(_Symbol, _Period) < requiredBars)
      return;

   //--- Only one position for this EA on this symbol
   if(HasOpenPosition())
      return;

   //--- Spread filter
   if(!IsSpreadAcceptable())
      return;

   //--- Get ATR from closed breakout candle
   double atr = GetATR();

   if(atr <= 0.0)
      return;

   //--- Get EMA from closed candle
   double ema = GetEMA();

   if(ema <= 0.0)
      return;

   //--- Breakout candle
   double candleOpen  = iOpen(_Symbol, _Period, 1);
   double candleClose = iClose(_Symbol, _Period, 1);
   double candleHigh  = iHigh(_Symbol, _Period, 1);
   double candleLow   = iLow(_Symbol, _Period, 1);

   if(candleOpen <= 0.0 ||
      candleClose <= 0.0 ||
      candleHigh <= 0.0 ||
      candleLow <= 0.0)
   {
      return;
   }

   //--- Candle range
   double candleRange = candleHigh - candleLow;

   if(candleRange <= 0.0)
      return;

   //--- ATR strength filter
   if(candleRange < atr * ATR_MinRangeMultiplier)
      return;

   //--- Channel levels
   double channelHigh;
   double channelLow;

   if(!GetChannel(channelHigh, channelLow))
      return;

   //==============================================================
   // BUY CONDITIONS
   //==============================================================
   //
   // 1. Closed candle breaks previous channel high
   // 2. Candle is bullish
   // 3. Price is above EMA
   // 4. Candle range is sufficiently large
   //
   //==============================================================

   bool buyBreakout = candleClose > channelHigh;
   bool bullishCandle = candleClose > candleOpen;
   bool bullishTrend = candleClose > ema;

   if(buyBreakout &&
      bullishCandle &&
      bullishTrend)
   {
      OpenBuy(atr);
      return;
   }

   //==============================================================
   // SELL CONDITIONS
   //==============================================================
   //
   // 1. Closed candle breaks previous channel low
   // 2. Candle is bearish
   // 3. Price is below EMA
   // 4. Candle range is sufficiently large
   //
   //==============================================================

   bool sellBreakout = candleClose < channelLow;
   bool bearishCandle = candleClose < candleOpen;
   bool bearishTrend = candleClose < ema;

   if(sellBreakout &&
      bearishCandle &&
      bearishTrend)
   {
      OpenSell(atr);
      return;
   }
}

//+------------------------------------------------------------------+
//| Detect new candle                                                 |
//+------------------------------------------------------------------+
bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, _Period, 0);

   if(currentBarTime <= 0)
      return false;

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| Get ATR value from bar 1                                          |
//+------------------------------------------------------------------+
double GetATR()
{
   double buffer[1];

   ResetLastError();

   int copied = CopyBuffer(
      atrHandle,
      0,
      1,
      1,
      buffer
   );

   if(copied != 1)
   {
      Print("ATR CopyBuffer failed. Error: ", GetLastError());
      return 0.0;
   }

   if(buffer[0] <= 0.0)
      return 0.0;

   return buffer[0];
}

//+------------------------------------------------------------------+
//| Get EMA value from bar 1                                         |
//+------------------------------------------------------------------+
double GetEMA()
{
   double buffer[1];

   ResetLastError();

   int copied = CopyBuffer(
      emaHandle,
      0,
      1,
      1,
      buffer
   );

   if(copied != 1)
   {
      Print("EMA CopyBuffer failed. Error: ", GetLastError());
      return 0.0;
   }

   if(buffer[0] <= 0.0)
      return 0.0;

   return buffer[0];
}

//+------------------------------------------------------------------+
//| Calculate price channel                                           |
//+------------------------------------------------------------------+
bool GetChannel(double &channelHigh, double &channelLow)
{
   channelHigh = -DBL_MAX;
   channelLow  = DBL_MAX;

   //--- IMPORTANT:
   //--- Bar 1 = breakout candle
   //--- Channel starts from bar 2
   //--- Therefore no look-ahead bias
   for(int shift = 2; shift <= ChannelPeriod + 1; shift++)
   {
      double high = iHigh(_Symbol, _Period, shift);
      double low  = iLow(_Symbol, _Period, shift);

      if(high <= 0.0 || low <= 0.0)
         return false;

      if(high > channelHigh)
         channelHigh = high;

      if(low < channelLow)
         channelLow = low;
   }

   if(channelHigh == -DBL_MAX ||
      channelLow == DBL_MAX)
   {
      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Check EA position                                                 |
//+------------------------------------------------------------------+
bool HasOpenPosition()
{
   int total = PositionsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol &&
         magic == MagicNumber)
      {
         return true;
      }
   }

   return false;
}

//+------------------------------------------------------------------+
//| Spread check                                                      |
//+------------------------------------------------------------------+
bool IsSpreadAcceptable()
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double point = SymbolInfoDouble(
      _Symbol,
      SYMBOL_POINT
   );

   if(point <= 0.0)
      return false;

   double spread = (tick.ask - tick.bid) / point;

   if(spread > (double)MaximumSpread)
      return false;

   return true;
}

//+------------------------------------------------------------------+
//| Normalize lot                                                     |
//+------------------------------------------------------------------+
double NormalizeLot(double lot)
{
   double minLot = SymbolInfoDouble(
      _Symbol,
      SYMBOL_VOLUME_MIN
   );

   double maxLot = SymbolInfoDouble(
      _Symbol,
      SYMBOL_VOLUME_MAX
   );

   double step = SymbolInfoDouble(
      _Symbol,
      SYMBOL_VOLUME_STEP
   );

   if(minLot <= 0.0 ||
      maxLot <= 0.0 ||
      step <= 0.0)
   {
      return 0.0;
   }

   if(lot < minLot)
      lot = minLot;

   if(lot > maxLot)
      lot = maxLot;

   lot = MathFloor(lot / step) * step;

   if(lot < minLot)
      lot = minLot;

   if(lot > maxLot)
      lot = maxLot;

   int digits = 0;
   double temp = step;

   while(digits < 8 &&
         MathAbs(temp - MathRound(temp)) > 0.00000001)
   {
      temp *= 10.0;
      digits++;
   }

   return NormalizeDouble(lot, digits);
}

//+------------------------------------------------------------------+
//| Minimum stop distance                                             |
//+------------------------------------------------------------------+
double GetMinimumStopDistance()
{
   long stopLevel = SymbolInfoInteger(
      _Symbol,
      SYMBOL_TRADE_STOPS_LEVEL
   );

   double point = SymbolInfoDouble(
      _Symbol,
      SYMBOL_POINT
   );

   if(point <= 0.0)
      return 0.0;

   return (double)stopLevel * point;
}

//+------------------------------------------------------------------+
//| Open BUY                                                          |
//+------------------------------------------------------------------+
void OpenBuy(double atr)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double lot = NormalizeLot(FixedLotSize);

   if(lot <= 0.0)
      return;

   double entry = tick.ask;

   if(entry <= 0.0)
      return;

   //--- ATR based SL
   double slDistance = atr * ATR_SL_Multiplier;

   double minimumDistance = GetMinimumStopDistance();

   if(slDistance < minimumDistance)
      slDistance = minimumDistance;

   if(slDistance <= 0.0)
      return;

   //--- TP based on risk/reward
   double tpDistance =
      slDistance * RiskRewardRatio;

   double sl = entry - slDistance;
   double tp = entry + tpDistance;

   sl = NormalizeDouble(sl, _Digits);
   tp = NormalizeDouble(tp, _Digits);

   //--- Final broker validation
   if((entry - sl) < minimumDistance)
      return;

   if((tp - entry) < minimumDistance)
      return;

   ResetLastError();

   bool result = trade.Buy(
      lot,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-06 PCB BUY"
   );

   if(!result)
   {
      Print(
         "BUY failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription(),
         " Error=",
         GetLastError()
      );
   }
}

//+------------------------------------------------------------------+
//| Open SELL                                                         |
//+------------------------------------------------------------------+
void OpenSell(double atr)
{
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double lot = NormalizeLot(FixedLotSize);

   if(lot <= 0.0)
      return;

   double entry = tick.bid;

   if(entry <= 0.0)
      return;

   //--- ATR based SL
   double slDistance = atr * ATR_SL_Multiplier;

   double minimumDistance = GetMinimumStopDistance();

   if(slDistance < minimumDistance)
      slDistance = minimumDistance;

   if(slDistance <= 0.0)
      return;

   //--- TP based on risk/reward
   double tpDistance =
      slDistance * RiskRewardRatio;

   double sl = entry + slDistance;
   double tp = entry - tpDistance;

   sl = NormalizeDouble(sl, _Digits);
   tp = NormalizeDouble(tp, _Digits);

   //--- Final broker validation
   if((sl - entry) < minimumDistance)
      return;

   if((entry - tp) < minimumDistance)
      return;

   ResetLastError();

   bool result = trade.Sell(
      lot,
      _Symbol,
      0.0,
      sl,
      tp,
      "EA-06 PCB SELL"
   );

   if(!result)
   {
      Print(
         "SELL failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription(),
         " Error=",
         GetLastError()
      );
   }
}
